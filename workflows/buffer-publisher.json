          }
        ]
      ]
    },
    "Read Post Status": {
      "main": [
        [
          {
            "node": "Publish Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still Processing": {
      "main": [
        [
          {
            "node": "Wait For Buffer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Show Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Ho_Chi_Minh",
    "executionTimeout": 180
  },
  "active": false,
  "pinData": {},
  "tags": []
